<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Tgs.PlayerBucket.Clients</RootNamespace>
		<PackageId>Tgs.PlayerBucket.Client</PackageId>
		<Title>Tgs.PlayerBucket.Client</Title>
		<Version>0.0.16</Version>
		<Authors>Raypro</Authors>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-playerbucket</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-playerbucket.git</RepositoryUrl>
		<PackageTags>Tgs PlayerBucket Bucket</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AsyncMethodNameFixer" Version="2.3.0" />
		<PackageReference Include="JsonPatch.Net" Version="2.1.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="7.0.0" />
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
		<PackageReference Include="System.Interactive.Async" Version="6.0.1" />
		<PackageReference Include="Tgs.MessageQueue" Version="2.3.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PlayerBucket.Common\PlayerBucket.Common.csproj">
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
		<PackageReference Include="PhoenixToolkits.NuGet.BuildTools" Version="0.0.2">
			<PrivateAssets>All</PrivateAssets>
		</PackageReference>
	</ItemGroup>

</Project>
