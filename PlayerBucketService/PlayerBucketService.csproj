<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>4c87f46c-cf59-4366-a85f-1dba82689739</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileTag Condition="$(DockerfileTag) == ''">pgtgs/bucket-service</DockerfileTag>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.0.0" />
		<PackageReference Include="AsyncMethodNameFixer" Version="2.3.0" />
		<PackageReference Include="FluentdForward.OpenTelemetry.MessagePack" Version="0.3.4" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.6" />
		<PackageReference Include="Npgsql.OpenTelemetry" Version="8.0.1" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.7.0" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.7.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.7.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.7.0" />
		<PackageReference Include="PhoenixToolkits.MessageQueue.Nats" Version="2.0.0" />
		<PackageReference Include="ProfileViewer.OpenTelemetry.Exporter" Version="0.3.1" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
		<PackageReference Include="Tgs.WebApi.Toolkits" Version="0.3.0" />
		<PackageReference Include="Tgs.WebApi.Toolkits.Swashbuckle" Version="0.3.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PlayerBucket.Client\PlayerBucket.Client.csproj" />
		<ProjectReference Include="..\PlayerBucketService.Core\PlayerBucketService.Core.csproj" />
		<ProjectReference Include="..\PlayerBucketService.Repositories\PlayerBucketService.Repositories.csproj" />
	</ItemGroup>

</Project>
