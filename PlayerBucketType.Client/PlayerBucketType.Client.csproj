<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tgs.PlayerBucket.Client</RootNamespace>
    <PackageId>Tgs.PlayerBucketType.Client</PackageId>
    <Title>遊戲類型封裝的PlayerBucket Client函式庫</Title>
    <Version>0.0.8</Version>
    <Authors>Raypro</Authors>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-playerbucket</PackageProjectUrl>
    <PackageTags>Tgs PlayerBucket Bucket</PackageTags>
    <RepositoryUrl>https://gitlab.com/rayprosoft/tgs-playerbucket.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PhoenixToolkits.NuGet.BuildTools" Version="0.0.2">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Interactive" Version="6.0.1" />
    <PackageReference Include="System.Interactive.Async" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlayerBucket.Client\PlayerBucket.Client.csproj" />
    <ProjectReference Include="..\PlayerBucket.Common\PlayerBucket.Common.csproj">
      <PrivateAssets>All</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
